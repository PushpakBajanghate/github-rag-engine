# LLM & Embedding API Keys (Provide Google Gemini or OpenAI)
GOOGLE_API_KEY=your_google_gemini_api_key_here
# GEMINI_API_KEY=your_google_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# GitHub Configuration (Optional for public repos, required for private or high rate limits)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Local ChromaDB Vector Store Path
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# FlashRank Reranker Model
FLASH_RANK_MODEL=ms-marco-TinyBERT-L-2-v2
